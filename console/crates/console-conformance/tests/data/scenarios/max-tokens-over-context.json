{
  "id": "max-tokens-over-context",
  "description": "A max_tokens equal to the context is refused with 400 context_length_exceeded over both APIs.",
  "donor": [
    "serve/test_server.py::MaxTokens::test_explicit_budget_over_the_context_is_rejected"
  ],
  "notes": "The donor's script is \"</think>\\n\\n\" followed by 2000 letters drawn by random.Random(2000). Both requests are refused before generation, so the engine never replays it and a short stand-in is used.",
  "engine": {
    "kind": "mock",
    "tokenizer": {
      "kind": "byte"
    },
    "script": [
      "</think>\n\nstand-in answer"
    ],
    "max_context": 4096
  },
  "template": "vendor:serve/chat_template.jinja",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "headers": [
          [
            "Content-Type",
            "application/json"
          ]
        ],
        "body": {
          "model": "m",
          "messages": [
            {
              "role": "user",
              "content": "hi"
            }
          ],
          "max_tokens": 4096
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/messages",
        "headers": [
          [
            "Content-Type",
            "application/json"
          ]
        ],
        "body": {
          "model": "m",
          "messages": [
            {
              "role": "user",
              "content": "hi"
            }
          ],
          "max_tokens": 4096
        }
      }
    }
  ],
  "observe": {
    "http": true,
    "engine_tape": true
  }
}
