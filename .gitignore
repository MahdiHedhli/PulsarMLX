# Rust build output. Cargo.lock is tracked in PulsarMLX for reproducibility.
target/
*.bin.tmp
debug/
release/
*.rs.bk
*.rlib
*.prof*

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
*.tmp
*.swp
.vscode/
.idea/

# Local model weights and model caches
models/
weights/
checkpoints/
*.gguf
*.gguf.warm
*.ctx-state
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
.cache/huggingface/
.huggingface/
# The rule above keeps real weights out of the repository. The synthetic
# Safetensors fixtures are a few hundred KB of generated bytes carrying no
# model, are reproduced byte for byte by
# scripts/research/generate_safetensors_fixtures_v1.py, and are listed with
# their sha256 in fixtures/safetensors/manifest.json, so they are excepted by
# path rather than by extension.
!fixtures/safetensors/**/*.safetensors
!fixtures/native-composition/**

# Local-only research scratch space. These paths are defense-in-depth for an
# accidentally repo-local run; validated specifications, schemas, fixtures,
# and evidence under specs/, schemas/, fixtures/, and docs/ remain tracked.
.pulsarmlx-local/research-work/
.pulsarmlx-local/candidate-output/
.pulsarmlx-local/oracle-build/
.pulsarmlx-local/external-model/
.pulsarmlx-local/cache/
.pulsarmlx-local/logs/
.pulsarmlx-local/secrets/

# Versioned model admission records are documentation, not model artifacts.
!docs/validation/models/
docs/validation/models/*
!docs/validation/models/*.json

# Local benchmark output, profiles, traces, and logs
bench/results/
benchmarks/results/
artifacts/benchmarks/
*.bench.json
*.benchmark.json
*.trace.json
*.prof
*.perf
logs/
*.log

# Secrets and private local configuration
.env
.env.*
!.env.example
!.env.template
.ssh/
id_rsa*
id_ed25519*
*.pem
*.key
credentials.json
secrets.*
mcp.json
mcp.local.json

# Spec Kit's generated specifications, templates, scripts, manifests, active
# feature state, and Codex skills are committed. Ignore any other future
# agent-local state under .agents/ while retaining the official skills.
.agents/*
!.agents/skills/
!.agents/skills/**

.gitnexus

# gitnexus local code-intelligence (tooling, not for the public repo)
.gitnexus/
CLAUDE.md
.claude/
AGENTS.md
