{
  "title": "PulsarMLX Console volatile fields",
  "rule": "specs/022-console-serving-parity/contracts/parity-ledger.md section 1.1: everything the server sends is observable unless it is listed here. Each listed field is replaced by its class placeholder only after its class check passes, so a field that fails the check is still a difference. Header names and positions stay observable; of Date and Server only the values are volatile (tasks.md R29). Names are the donor's, as observed on the reference side before the rename map applies. Read and checked by console-conformance::scenario::VolatileFields; applied by the normalizer of CNF-04, which reviews this list against the donor's response builders.",
  "donor_commit": "7e68a30f2f208056195352129188661fb6b94445",
  "classes": [
    {"class": "id", "placeholder": "<prefix#k>", "check": "the prefix then exactly the listed number of lower-case hex digits; numbered by first appearance across the whole scenario, so cross-references stay checkable"},
    {"class": "epoch-s", "placeholder": "<epoch-s>", "check": "an integer number of seconds since the epoch within the run window"},
    {"class": "epoch-float", "placeholder": "<epoch-s>", "check": "a number of seconds since the epoch, integer or fraction, within the run window"},
    {"class": "iso", "placeholder": "<iso>", "check": "an ISO-8601 time stamp in UTC that parses and lies within the run window"},
    {"class": "num", "placeholder": "<num>", "check": "a number, non-negative; null stays null and is compared exactly"},
    {"class": "header-value", "placeholder": "<header>", "check": "the header is present once, at the same position; its value is a non-empty string"},
    {"class": "pid", "placeholder": "<pid>", "check": "a positive integer"},
    {"class": "port", "placeholder": "{{port}}", "check": "an integer from 1 to 65535, equal to the port the scenario's server listens on where it names that port"},
    {"class": "tmp-path", "placeholder": "{{tmp}}", "check": "a path under the scenario's temporary directory"}
  ],
  "fields": [
