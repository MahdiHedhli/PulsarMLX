{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulsarmlx.f017.m1d-execution-config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "status", "attempt", "attempt_consumed",
    "runtime_sha", "tooling_sha", "repository_root", "package_root",
    "activation_fixture", "activation_payload_sha256", "provenance", "repository_artifacts",
    "local_artifacts", "prior_evidence", "checkpoint_bindings", "runner",
    "execution"
  ],
  "properties": {
    "schema": {"const": "pulsarmlx.f017.m1d-execution-config"},
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "READY_TO_EXECUTE_ATTEMPT_3"},
    "attempt": {"const": 3},
    "attempt_consumed": {"const": false},
    "runtime_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tooling_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_root": {"$ref": "#/$defs/root"},
    "package_root": {"$ref": "#/$defs/root"},
    "activation_fixture": {"$ref": "#/$defs/repositoryArtifact"},
    "activation_payload_sha256": {"$ref": "#/$defs/sha256"},
    "provenance": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "repository_artifacts": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"$ref": "#/$defs/repositoryArtifact"}
    },
    "local_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_manifest", "checkpoint_manifest", "target_shard", "oracle_output", "package_output", "evidence_output"],
      "properties": {
        "environment_manifest": {"$ref": "#/$defs/localFile"},
        "checkpoint_manifest": {"$ref": "#/$defs/localFile"},
        "target_shard": {"$ref": "#/$defs/targetShard"},
        "oracle_output": {"type": "string", "minLength": 1},
        "package_output": {"type": "string", "minLength": 1},
        "evidence_output": {"type": "string", "minLength": 1}
      }
    },
    "prior_evidence": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "checkpoint_bindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "runner": {"type": "object"},
    "execution": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["path_kind", "path", "identity"],
      "properties": {
        "path_kind": {"const": "absolute_private_local"},
        "path": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "repositoryArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path_kind", "symbolic_path", "content_sha256", "logical_role"],
      "properties": {
        "path_kind": {"const": "repository_relative"},
        "symbolic_path": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "logical_role": {"type": "string", "minLength": 1}
      }
    },
    "localFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path_kind", "path", "content_sha256"],
      "properties": {
        "path_kind": {"const": "absolute_private_local"},
        "path": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "targetShard": {
      "type": "object", "additionalProperties": false,
      "required": ["path_kind", "path", "basename", "ordinal", "byte_size", "sha256"],
      "properties": {
        "path_kind": {"const": "absolute_private_local"},
        "path": {"type": "string", "minLength": 1},
        "basename": {"type": "string", "minLength": 1},
        "ordinal": {"const": 2},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
