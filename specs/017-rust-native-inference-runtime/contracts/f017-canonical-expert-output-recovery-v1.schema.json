        "gguf_shape": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "logical_decoded_shape": {"enum": [[2048, 6144], [6144, 2048]]},
        "decoded_f32_bytes": {"const": 50331648},
        "allowed_read_count": {"const": 1},
        "expected_packed_sha256": {"type": "null"},
