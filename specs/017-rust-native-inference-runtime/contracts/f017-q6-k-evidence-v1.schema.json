{
  "$id": "pulsarmlx.f017.q6-k-real-byte-evidence.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access": {
      "required": [
        "shard_opens",
        "positional_reads",
        "tensor_payloads",
        "packed_bytes"
      ],
      "type": "object"
    },
    "attempt": {
      "required": [
        "attempt_id",
        "authorized",
        "consumed",
        "executed",
        "checkpoint_accessed",
        "terminal_class"
      ],
      "type": "object"
    },
    "comparison": {
      "required": [
        "bitwise_equal",
        "first_divergence"
      ],
      "type": "object"
    },
    "decoder_outputs": {
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "identity": {
      "required": [
        "checkpoint_set_sha256",
        "tensor_name",
        "shard_ordinal",
        "offset",
        "packed_length",
        "packed_sha256",
        "format_contract_sha256",
        "corrected_decoder_source_sha256",
        "defect_evidence_sha256"
      ],
      "type": "object"
    },
    "isolation": {
      "required": [
        "model_compute",
        "mlx_candidate_dispatches",
        "dense_prefix_executed"
      ],
      "type": "object"
    },
    "ledger": {
      "required": [
        "before",
        "actual_payloads",
        "after"
      ],
      "type": "object"
    },
    "schema": {
      "const": "pulsarmlx.f017.q6-k-real-byte-qualification-evidence"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "target": {
      "required": [
        "tensor_name",
        "shard_ordinal",
        "offset",
        "packed_length",
        "logical_shape",
        "gguf_shape",
        "quantization",
        "block_arithmetic"
      ],
      "type": "object"
    },
    "defect_closure": {
      "required": [
        "defect_id",
        "real_byte_side_closed",
        "defect_evidence_sha256",
        "corrected_decoder_sha256"
      ],
      "type": "object"
    },
    "verdict": {
      "enum": [
        "EXACT_REAL_BYTE_QUALIFIED",
        "Q6_K_DECODER_TRUTH_UNRESOLVED",
        "REJECTED"
      ]
    }
  },
  "required": [
    "schema",
    "schema_version",
    "attempt",
    "identity",
    "target",
    "access",
    "decoder_outputs",
    "comparison",
    "defect_closure",
    "isolation",
    "ledger",
    "verdict"
  ],
  "type": "object"
}
