    "status": {"const":"PREPARED_REVIEW_REQUIRED"},
    "authoritative_repository": {"type":"object","additionalProperties":false,"required":["branch","preparation_base_commit"],"properties":{"branch":{"const":"feat/017-real-checkpoint-runner"},"preparation_base_commit":{"pattern":"^[0-9a-f]{40}$"}}},
    "authorization_candidate": {"$ref":"#/$defs/fileBinding"},
