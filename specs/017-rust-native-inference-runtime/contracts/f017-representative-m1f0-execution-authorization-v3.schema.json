    "synthetic_rehearsal": {"allOf":[{"$ref":"#/$defs/fileBinding"},{"type":"object","required":["failure_paths_exact"],"properties":{"failure_paths_exact":{"const":29}}}]},
    "review_authority": {"allOf":[{"$ref":"#/$defs/fileBinding"},{"type":"object","required":["verdict"],"properties":{"verdict":{"const":"REJECT_REPAIRED_APPEND_ONLY"}}}]},
    "validator": {"type":"object","required":["path","sha256","schema_path","schema_sha256"],"properties":{"path":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"},"schema_path":{"type":"string"},"schema_sha256":{"$ref":"#/$defs/sha256"}}},
