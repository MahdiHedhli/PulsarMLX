{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MahdiHedhli/PulsarMLX/specs/017-rust-native-inference-runtime/contracts/canonical-runner-evidence-v1.schema.json",
  "title": "PulsarMLX Feature 017 canonical runner evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "identity",
    "admission",
    "input",
    "execution",
    "residency",
    "lifecycle",
    "result"
  ],
  "properties": {
    "schema": { "const": "pulsarmlx.f017.canonical-runner-evidence" },
    "schema_version": { "const": "1.3.0" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "source_clean", "runner_version", "environment_kind", "environment_manifest_sha256", "platform", "toolchain", "loaded_libraries", "checkpoint"],
      "properties": {
        "source_sha": { "$ref": "#/$defs/sha256OrGit" },
        "source_clean": { "type": "boolean" },
        "runner_version": { "type": "string", "minLength": 1 },
        "environment_kind": { "enum": ["production_reviewed", "checkpoint_free_fixture"] },
        "environment_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "platform": { "type": "object" },
        "toolchain": { "type": "object" },
        "loaded_libraries": { "type": "array", "items": { "$ref": "#/$defs/loadedLibrary" } },
        "checkpoint": { "$ref": "#/$defs/checkpointIdentity" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telemetry_source", "physical_memory_bytes", "memory_floor_bytes", "available_memory_bytes", "compressed_memory_bytes", "memory_pressure", "swap_used_bytes", "checkpoint_volume_free_bytes", "evidence_volume_free_bytes", "load_averages", "competing_processes_clear", "competing_processes", "port_1234_listener", "thermal_state", "performance_warning", "stream_mode", "singleton_initially_unclaimed"],
      "properties": {
        "telemetry_source": { "enum": ["measured_host", "synthetic_fixture", "unavailable"] },
        "physical_memory_bytes": { "type": "integer", "minimum": 0 },
        "memory_floor_bytes": { "type": "integer", "minimum": 1 },
        "available_memory_bytes": { "type": "integer", "minimum": 0 },
        "compressed_memory_bytes": { "type": "integer", "minimum": 0 },
        "memory_pressure": { "enum": ["normal", "warning", "critical", "urgent", "unknown", "synthetic"] },
        "swap_used_bytes": { "type": "integer", "minimum": 0 },
        "checkpoint_volume_free_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "evidence_volume_free_bytes": { "type": "integer", "minimum": 0 },
        "load_averages": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0 } },
        "competing_processes_clear": { "type": "boolean" },
        "competing_processes": { "type": "array", "items": { "type": "string" } },
        "port_1234_listener": { "type": "boolean" },
        "thermal_state": { "enum": ["normal", "warning", "unavailable", "not_applicable"] },
        "performance_warning": { "type": "boolean" },
        "stream_mode": { "enum": ["default_gpu", "owned_device"] },
        "singleton_initially_unclaimed": { "type": "boolean" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "n_new", "expected_token", "validation_mode", "mode", "numerical_mode"],
      "properties": {
        "tokens": { "type": "array", "minItems": 0, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
        "n_new": { "type": "integer", "minimum": 0 },
        "expected_token": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967295 },
        "validation_mode": { "enum": ["golden_strict", "teacher_forced_validation"] },
        "mode": { "enum": ["dry_run", "adapter_preflight", "checkpoint_identity", "fixture_checkpoint_identity", "fixture", "p1"] },
        "numerical_mode": { "enum": ["exact_qualification_scaffold", "production_mlx_tier_b", null] }
      }
    },
    "execution": { "$ref": "#/$defs/execution" },
    "residency": { "$ref": "#/$defs/residency" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "first_failure", "stop_reason", "completed"],
      "properties": {
        "classification": { "enum": ["PASS", "FAIL_ADMISSION_ENVIRONMENT", "FAIL_CHECKPOINT_IDENTITY", "FAIL_LIFECYCLE_OWNERSHIP", "FAIL_NUMERICAL_BEHAVIORAL", "FAIL_INFRASTRUCTURE_EVIDENCE", "CANCELLED", "INCOMPLETE"] },
        "first_failure": { "type": ["object", "null"] },
        "stop_reason": { "type": ["string", "null"] },
        "completed": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "input": {
            "properties": { "validation_mode": { "const": "golden_strict" } }
          },
          "execution": {
            "properties": {
              "numerical_classification": { "const": "numerically_qualified_greedy_divergent" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": { "classification": { "const": "FAIL_NUMERICAL_BEHAVIORAL" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256OrGit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "loadedLibrary": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "resolved_basename", "actual_sha256", "expected_sha256", "architecture"],
      "properties": {
        "artifact": { "enum": ["mlx_native", "mlx_c"] },
        "resolved_basename": { "enum": ["libmlx.dylib", "libmlxc.dylib"] },
        "actual_sha256": { "$ref": "#/$defs/sha256" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "architecture": { "const": "arm64" }
      }
    },
    "checkpointIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessed", "revision", "checkpoint_set_sha256", "catalog_sha256", "architecture", "tokenizer_identity", "tensor_count", "tensor_map", "shards"],
      "properties": {
        "accessed": { "type": "boolean" },
        "revision": { "type": ["string", "null"] },
        "checkpoint_set_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "catalog_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "architecture": { "type": ["string", "null"] },
        "tokenizer_identity": { "type": ["string", "null"] },
        "tensor_count": { "type": ["integer", "null"], "minimum": 0 },
        "tensor_map": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "version", "contract_sha256", "validated_tensor_count"],
          "properties": {
            "status": { "enum": ["validated", "not_applicable", "unavailable"] },
            "version": { "type": ["string", "null"] },
            "contract_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "validated_tensor_count": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "shards": { "type": "array", "items": { "type": "object" } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "timings", "storage", "dispatch", "generated_token", "numerical_classification", "numerical", "progress_state"],
      "properties": {
        "layers": { "type": "array", "items": { "type": "object" } },
        "timings": { "type": "object" },
        "storage": { "type": "object" },
        "dispatch": { "type": "object" },
        "generated_token": { "type": ["integer", "null"] },
        "numerical_classification": {
          "enum": [
            "golden_identical",
            "numerically_qualified_greedy_not_applicable",
            "numerically_qualified_greedy_identical",
            "numerically_qualified_greedy_divergent",
            "numerically_failed",
            null
          ]
        },
        "numerical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["greedy_applicability", "greedy_identity", "oracle_generator_sha", "scaffold_version", "production_backend_version", "frozen_contract_version", "frozen_contract_versions", "bit_mismatch_count", "max_abs_error", "relative_error", "rmse", "cosine_similarity", "deterministic_repeat_count", "first_divergence"],
          "properties": {
            "greedy_applicability": { "enum": ["not_applicable", "applicable", null] },
            "greedy_identity": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["top_k_ids_exact", "argmax_exact"],
                  "properties": {
                    "top_k_ids_exact": { "type": "boolean" },
                    "argmax_exact": { "type": "boolean" }
                  }
                }
              ]
            },
            "oracle_generator_sha": { "type": ["string", "null"] },
            "scaffold_version": { "type": ["string", "null"] },
            "production_backend_version": { "type": ["string", "null"] },
            "frozen_contract_version": { "type": ["string", "null"] },
            "frozen_contract_versions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } },
            "bit_mismatch_count": { "type": ["integer", "null"], "minimum": 0 },
            "max_abs_error": { "type": ["number", "null"], "minimum": 0 },
            "relative_error": { "type": ["number", "null"], "minimum": 0 },
            "rmse": { "type": ["number", "null"], "minimum": 0 },
            "cosine_similarity": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
            "deterministic_repeat_count": { "type": ["integer", "null"], "minimum": 0 },
            "first_divergence": { "type": ["object", "null"] }
          }
        },
        "progress_state": { "type": "string" },
        "projection_count": { "type": "integer", "minimum": 0 },
        "quant_decode_count": { "type": "integer", "minimum": 0 },
        "expert_execution_count": { "type": "integer", "minimum": 0 },
        "layer_execution_count": { "type": "integer", "minimum": 0 },
        "logits_count": { "type": "integer", "minimum": 0 },
        "p1": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "numerical": {
                "properties": { "greedy_applicability": { "const": "not_applicable" } }
              }
            }
          },
          "then": {
            "properties": {
              "numerical_classification": {
                "enum": ["golden_identical", "numerically_qualified_greedy_not_applicable", "numerically_failed"]
              },
              "numerical": { "properties": { "greedy_identity": { "type": "null" } } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "numerical_classification": { "const": "numerically_qualified_greedy_identical" }
            }
          },
          "then": {
            "properties": {
              "numerical": {
                "properties": {
                  "greedy_applicability": { "const": "applicable" },
                  "greedy_identity": {
                    "type": "object",
                    "properties": {
                      "top_k_ids_exact": { "const": true },
                      "argmax_exact": { "const": true }
                    },
                    "required": ["top_k_ids_exact", "argmax_exact"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "numerical_classification": { "const": "numerically_qualified_greedy_not_applicable" }
            }
          },
          "then": {
            "properties": {
              "numerical": {
                "properties": {
                  "greedy_applicability": { "const": "not_applicable" },
                  "greedy_identity": { "type": "null" }
                }
              }
            }
          }
        }
      ]
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compressed", "decoded_hot", "native_ready_hot", "transient", "protected_shared", "hits", "misses", "evictions"],
      "properties": {
        "compressed": { "type": "integer", "minimum": 0 },
        "decoded_hot": { "type": "integer", "minimum": 0 },
        "native_ready_hot": { "type": "integer", "minimum": 0 },
        "transient": { "type": "integer", "minimum": 0 },
        "protected_shared": { "type": "integer", "minimum": 0 },
        "hits": { "type": "integer", "minimum": 0 },
        "misses": { "type": "integer", "minimum": 0 },
        "evictions": { "type": "integer", "minimum": 0 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre", "post", "reconciled"],
      "properties": {
        "pre": { "$ref": "#/$defs/lifecycleCounters" },
        "post": { "$ref": "#/$defs/lifecycleCounters" },
        "reconciled": { "type": "boolean" }
      }
    },
    "lifecycleCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed_created", "managed_destroyed", "derived_created", "derived_destroyed", "callback_count", "default_cpu_stream_created", "default_cpu_stream_freed", "default_gpu_stream_created", "default_gpu_stream_freed", "owned_stream_created", "owned_stream_freed", "active_contexts", "singleton_claimed", "active_registrations", "pending_registration_destructions", "in_flight_work", "live_owner_tokens", "stale_generations"],
      "properties": {
        "managed_created": { "type": "integer", "minimum": 0 },
        "managed_destroyed": { "type": "integer", "minimum": 0 },
        "derived_created": { "type": "integer", "minimum": 0 },
        "derived_destroyed": { "type": "integer", "minimum": 0 },
        "callback_count": { "type": "integer", "minimum": 0 },
        "default_cpu_stream_created": { "type": "integer", "minimum": 0 },
        "default_cpu_stream_freed": { "type": "integer", "minimum": 0 },
        "default_gpu_stream_created": { "type": "integer", "minimum": 0 },
        "default_gpu_stream_freed": { "type": "integer", "minimum": 0 },
        "owned_stream_created": { "type": "integer", "minimum": 0 },
        "owned_stream_freed": { "type": "integer", "minimum": 0 },
        "active_contexts": { "type": "integer", "minimum": 0 },
        "singleton_claimed": { "type": "boolean" },
        "active_registrations": { "$ref": "#/$defs/observedCounter" },
        "pending_registration_destructions": { "$ref": "#/$defs/observedCounter" },
        "in_flight_work": { "$ref": "#/$defs/observedCounter" },
        "live_owner_tokens": { "$ref": "#/$defs/observedCounter" },
        "stale_generations": { "$ref": "#/$defs/observedCounter" }
      }
    },
    "observedCounter": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "enum": ["measured_zero", "measured_nonzero", "not_applicable", "unavailable"] },
        "value": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
